# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
#
# .env.local is git-ignored (.gitignore: .env*.local). This file must only ever
# contain placeholders - never paste a real key into it.

# ===================
# App Configuration
# ===================
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===================
# MongoDB
# ===================
# Atlas SRV connection string. Resolving it needs working DNS on the host -
# see the Troubleshooting section of the README if you hit querySrv ECONNREFUSED.
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/hyades

# ===================
# Clerk Authentication
# ===================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk webhook signing secret, verified with svix in
# app/api/webhooks/clerk/route.ts
WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===================
# Cloudinary
# ===================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================
# Stripe Payments
# ===================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
